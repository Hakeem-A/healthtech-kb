# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=healthtech_kb
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/healthtech_kb

# Security & Authentication (Generate random secret in production)
SECRET_KEY=change-this-insecure-secret-key-in-production-12345678

# AI Assistant (Google Gemini API Key - Optional)
GEMINI_API_KEY=

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:3000

# Standalone HMIS Widget Authorization
WIDGET_API_KEYS=demo-widget-api-key
